DATABASE_URL="postgresql://postgres:postgres@localhost:5432/colony_maintenance?schema=public&sslmode=disable&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/colony_maintenance?schema=public&sslmode=disable"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# synthetic is restricted to loopback mcm_test_* targets and allowlisted empty/QA identities.
# production rejects synthetic identity assertions. NODE_ENV=production builds may still use the
# synthetic profile for build-time verification because the runtime guard checks the real DB target.
MCM_DEPLOYMENT_PROFILE="production"

# Local empty-instance bootstrap only. Never enable these for a populated database.
EMPTY_COLONY_BOOTSTRAP="false"
EMPTY_PROFILE_SWITCHER="false"
EMPTY_PROFILE_INSTANCE_ID="replace-with-a-unique-random-instance-id"
EMPTY_ADMIN_PASSWORD="replace-with-a-unique-local-password"

# Required only by db:seed:role-qa. Supply at execution time; do not commit a real password.
ROLE_QA_PASSWORD=""

# Per-worker secrets. Generate distinct random values of at least 32 characters; empty values disable that worker.
OUTBOX_WORKER_TOKEN_NOTIFICATION_DELIVERY=""
OUTBOX_WORKER_TOKEN_BILLING_DELIVERY=""
OUTBOX_WORKER_TOKEN_SOP_DELIVERY=""
OUTBOX_WORKER_TOKEN_SECURITY_AUDIT=""
OUTBOX_WORKER_TOKEN_WORKFLOW_DISPATCH=""

# Deployment-controlled notification provider. Production requires HTTPS, an explicit public-host allowlist,
# no redirects, and an adapter that honors Idempotency-Key for the outbox retry window.
NOTIFICATION_EMAIL_PROVIDER_URL=""
NOTIFICATION_EMAIL_PROVIDER_HOSTS=""
NOTIFICATION_EMAIL_FROM=""
NOTIFICATION_EMAIL_API_TOKEN=""
# Required contract acknowledgement: the adapter must deduplicate Idempotency-Key for the full outbox retry window.
NOTIFICATION_EMAIL_PROVIDER_SUPPORTS_IDEMPOTENCY="false"
