{
  "name": "colony-maintenance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install chromium",
    "e2e:install:wsl": "bash scripts/with-playwright-wsl-libs.sh playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:wsl": "bash scripts/with-playwright-wsl-libs.sh playwright test",
    "verify": "npm run prisma:validate && npm run typecheck && npm run lint && npm test && npm run build",
    "verify:e2e": "playwright test --reporter=line",
    "verify:e2e:wsl": "bash scripts/with-playwright-wsl-libs.sh playwright test --reporter=line",
    "verify:all": "npm run verify && npm run verify:e2e",
    "verify:all:wsl": "npm run verify && npm run verify:e2e:wsl",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:prepare": "npm run db:push && npm run db:seed",
    "db:prepare:ci": "npm run db:migrate && npm run db:seed",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@tanstack/react-table": "^8.21.3",
    "@zxing/browser": "^0.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.552.0",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.1",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
