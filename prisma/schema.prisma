model ProcedurePlan {
  id                           String                      @id
  labId                        String
  experimentId                 String
  assignmentId                 String
  procedureCode                String
  title                        String
  scheduledAt                  DateTime
  status                       ProcedurePlanStatus         @default(planned)
  sopId                        String
  sopVersionId                 String
  sopVersionNumber             Int
  sopContentHash               String
  sopAssignmentId              String
  assignmentContextSnapshot    Json
  experimentContextSnapshot    Json
  createdById                  String
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  version                      Int                         @default(1)
  protocolAuthorizationId      String?
  complianceEvidenceSnapshotId String?
  lab                          Lab                         @relation(fields: [labId], references: [id], onDelete: Restrict)
  experiment                   Experiment                  @relation(fields: [experimentId, labId], references: [id, labId], onDelete: Restrict, onUpdate: NoAction)
  assignment                   ExperimentAssignment        @relation(fields: [assignmentId, experimentId], references: [id, experimentId], onDelete: Restrict, onUpdate: NoAction)
  sop                          SopDocument                 @relation("ProcedurePlanSop", fields: [sopId], references: [id], onDelete: Restrict)
  sopVersion                   SopVersion                  @relation("ProcedurePlanSopVersion", fields: [sopVersionId, sopId], references: [id, sopId], onDelete: Restrict, onUpdate: NoAction)
  sopAssignment                SopAssignment               @relation("ProcedurePlanSopAssignment", fields: [sopAssignmentId, sopId, sopVersionId, labId], references: [id, sopId, sopVersionId, labId], onDelete: Restrict, onUpdate: NoAction)
  createdBy                    User                        @relation("ProcedurePlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  occurrences                  ProcedureOccurrence[]
  protocolAuthorization        ProtocolAuthorization?      @relation(fields: [protocolAuthorizationId], references: [id], onDelete: Restrict)
  complianceEvidence           ComplianceEvidenceSnapshot? @relation(fields: [complianceEvidenceSnapshotId], references: [id], onDelete: Restrict)

  @@unique([id, labId])
  @@index([labId, status, scheduledAt])
  @@index([experimentId, scheduledAt])
  @@index([assignmentId, status])
  @@index([sopId, sopVersionId])
  @@index([sopAssignmentId])
}

model ProcedureOccurrence {
