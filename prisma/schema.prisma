  destinationLab                          Lab                         @relation("LabTransferDestinationLab", fields: [destinationLabId], references: [id], onDelete: Restrict)
  sourceCage                              Cage?                       @relation("LabTransferSourceCage", fields: [sourceCageId], references: [id], onDelete: Restrict)
  destinationCage                         Cage?                       @relation("LabTransferDestinationCage", fields: [destinationCageId], references: [id], onDelete: Restrict)
  requestedBy                             User                        @relation("LabTransferRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  destinationDecisionBy                   User?                       @relation("LabTransferDestinationDecision", fields: [destinationDecisionById], references: [id], onDelete: Restrict)
  finalizedBy                             User?                       @relation("LabTransferFinalizer", fields: [finalizedById], references: [id], onDelete: Restrict)
  overrideApprovedBy                      User?                       @relation("LabTransferOverrideApprover", fields: [overrideApprovedById], references: [id], onDelete: Restrict)
  items                                   LabTransferItem[]
  packets                                 LabTransferPacket[]
  events                                  LabTransferEvent[]
  cageTransfers                           CageLabTransfer[]
  animalTransfers                         AnimalLabTransfer[]
  animalMovements                         AnimalMovement[]
  sourceProtocolAuthorization             ProtocolAuthorization?      @relation("LabTransferSourceProtocol", fields: [sourceProtocolAuthorizationId], references: [id], onDelete: Restrict)
  sourceComplianceEvidence                ComplianceEvidenceSnapshot? @relation("LabTransferSourceEvidence", fields: [sourceComplianceEvidenceSnapshotId], references: [id], onDelete: Restrict)
  destinationProtocolAuthorization        ProtocolAuthorization?      @relation("LabTransferDestinationProtocol", fields: [destinationProtocolAuthorizationId], references: [id], onDelete: Restrict)
  destinationComplianceEvidence           ComplianceEvidenceSnapshot? @relation("LabTransferDestinationEvidence", fields: [destinationComplianceEvidenceSnapshotId], references: [id], onDelete: Restrict)
  destinationProtocolCountAllocation      ProtocolCountAllocation?    @relation(fields: [destinationProtocolCountAllocationId], references: [id], onDelete: Restrict)

  @@index([sourceLabId, status])
  @@index([destinationLabId, status])
  @@index([status, requestedAt])
  @@index([sourceCageId])
  @@index([destinationCageId])
}

model LabTransferItem {
  id           String             @id
  requestId    String
  animalId     String
  sourceCageId String?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  request      LabTransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  animal       Animal             @relation(fields: [animalId], references: [id], onDelete: Restrict)
  sourceCage   Cage?              @relation(fields: [sourceCageId], references: [id], onDelete: Restrict)

  @@unique([requestId, animalId])
  @@index([animalId])
  @@index([sourceCageId])
}

model LabTransferPacket {
  id                 String             @id
  requestId          String
  version            Int
  destinationPayload Json
  payloadHash        String
  createdById        String
  createdAt          DateTime           @default(now())
  request            LabTransferRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  createdBy          User               @relation("LabTransferPacketCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([requestId, version])
  @@index([createdById, createdAt])
}

model LabTransferEvent {
  id            String               @id
  requestId     String
  eventType     LabTransferEventType
  actorId       String
  actorRole     UserRole
  actorLabId    String?
  packetVersion Int
  reason        String?
  metadata      Json?
  createdAt     DateTime             @default(now())
  request       LabTransferRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor         User                 @relation("LabTransferEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorLab      Lab?                 @relation(fields: [actorLabId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorLabId, createdAt])
}

model Invoice {
  id                   String              @id
  invoiceNumber        String              @unique
  finalNumber          String?             @unique
  labId                String
  status               InvoiceStatus       @default(draft)
  periodStart          DateTime
  periodEnd            DateTime
  currencyCode         String              @default("USD")
  subtotalCents        Int                 @default(0)
  adjustmentTotalCents Int                 @default(0)
  totalCents           Int                 @default(0)
  finalizedAt          DateTime?
  finalizedById        String?
  voidedAt             DateTime?
  voidedById           String?
  voidReason           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  version              Int                 @default(1)
  lab                  Lab                 @relation(fields: [labId], references: [id], onDelete: Restrict)
  finalizedBy          User?               @relation("InvoiceFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  voidedBy             User?               @relation("InvoiceVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  lineItems            InvoiceLineItem[]
  adjustments          InvoiceAdjustment[]

  @@index([labId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

model InvoiceAdjustment {
  id                   String                @id
  invoiceId            String
  labId                String
  adjustmentType       InvoiceAdjustmentType
  amountCents          Int
  reason               String
  createdById          String
  reversesAdjustmentId String?               @unique
  createdAt            DateTime              @default(now())
  invoice              Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lab                  Lab                   @relation(fields: [labId], references: [id], onDelete: Restrict)
  createdBy            User                  @relation("InvoiceAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversesAdjustment   InvoiceAdjustment?    @relation("InvoiceAdjustmentReversal", fields: [reversesAdjustmentId], references: [id], onDelete: Restrict)
  reversedByAdjustment InvoiceAdjustment?    @relation("InvoiceAdjustmentReversal")

  @@index([invoiceId, createdAt])
  @@index([labId, createdAt])
  @@index([createdById, createdAt])
}

model InvoiceLineItem {
  id             String             @id
  invoiceId      String
  cageId         String
  chargePeriodId String
  categoryId     String
  description    String
  serviceStart   DateTime
  serviceEnd     DateTime
  dayCount       Int
  dailyRateCents Int
  amountCents    Int
  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cage           Cage               @relation(fields: [cageId], references: [id], onDelete: Restrict)
  chargePeriod   CageChargePeriod   @relation(fields: [chargePeriodId, cageId, categoryId], references: [id, cageId, categoryId], onDelete: Restrict, onUpdate: NoAction)
  category       CageChargeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([cageId])
}

model RuleConfig {
  id            String       @id
  key           String       @unique
  label         String
  category      RuleCategory
  valueType     String
  value         Json
  description   String?
  criticalBlock Boolean      @default(false)
  updatedAt     DateTime     @updatedAt
}

model Alert {
  id          String        @id
  labId       String?
  entityType  String
  entityId    String
  alertType   String
  severity    AlertSeverity
  message     String
  source      String
  status      AlertStatus   @default(open)
  generatedAt DateTime
  resolvedAt  DateTime?
  lab         Lab?          @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId, status])
}

model NotificationEvent {
  id          String                  @id
  sourceKey   String                  @unique
  source      String
  labId       String?
  categoryKey String
  severity    AlertSeverity
  message     String
  entityType  String
  entityId    String
  deepLink    String
  actionLabel String
  urgent      Boolean                 @default(false)
  status      AlertStatus             @default(open)
  occurredAt  DateTime
  resolvedAt  DateTime?
  version     Int                     @default(1)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  lab         Lab?                    @relation(fields: [labId], references: [id], onDelete: Restrict)
  audiences   NotificationAudience[]
  recipients  NotificationRecipient[]

  @@index([labId, status, occurredAt])
  @@index([categoryKey, status, occurredAt])
  @@index([entityType, entityId])
}

model NotificationAudience {
  id           String                   @id
  eventId      String
  audienceType NotificationAudienceType
  audienceKey  String
  userId       String?
  labId        String?
  facilityRole UserRole?
  createdAt    DateTime                 @default(now())
  event        NotificationEvent        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user         User?                    @relation("NotificationAudienceUser", fields: [userId], references: [id], onDelete: Restrict)
  lab          Lab?                     @relation(fields: [labId], references: [id], onDelete: Restrict)
  recipients   NotificationRecipient[]

  @@unique([eventId, audienceKey])
  @@index([userId, eventId])
  @@index([labId, eventId])
  @@index([facilityRole, eventId])
}

model NotificationRecipient {
  id                      String                      @id
  eventId                 String
  audienceId              String
  userId                  String
  labId                   String?
  recipientAuthzVersion   Int
  recipientRole           UserRole
  recipientMembershipRole LabMembershipRole?
  status                  NotificationRecipientStatus @default(active)
  materializedAt          DateTime                    @default(now())
  revokedAt               DateTime?
  revokeReason            String?
  readAt                  DateTime?
  acknowledgedAt          DateTime?
  resolvedAt              DateTime?
  version                 Int                         @default(1)
  event                   NotificationEvent           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  audience                NotificationAudience        @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  user                    User                        @relation("NotificationRecipientUser", fields: [userId], references: [id], onDelete: Restrict)
  lab                     Lab?                        @relation(fields: [labId], references: [id], onDelete: Restrict)
  deliveries              NotificationDelivery[]

  @@index([eventId, userId])
  @@index([userId, status, materializedAt])
  @@index([labId, status, materializedAt])
  @@index([audienceId])
}

model NotificationPreference {
  id              String                @id
  userId          String
  categoryKey     String
  inAppEnabled    Boolean               @default(true)
  emailMode       NotificationEmailMode @default(off)
  digestHourUtc   Int                   @default(8)
  digestDayOfWeek Int                   @default(1)
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryKey])
  @@index([userId, updatedAt])
}

model NotificationDelivery {
  id                        String                     @id
  recipientId               String
  recipientVersion          Int
  preferenceVersion         Int                        @default(0)
  eventVersion              Int?
  outboxMessageId           String                     @unique
  kind                      NotificationDeliveryKind
  status                    NotificationDeliveryStatus @default(queued)
  scheduledFor              DateTime
  deliveredTo               String?
  providerMessageId         String?
  providerStatus            Int?
  providerRequestBody       String?
  providerRequestHash       String?
  providerIdempotencyKey    String?
  providerRequestTo         String?
  providerAdapter           String?
  providerEndpoint          String?
  providerAccount           String?
  providerRequestPreparedAt DateTime?
  attemptCount              Int                        @default(0)
  lastError                 String?
  deliveredAt               DateTime?
  failedAt                  DateTime?
  cancelledAt               DateTime?
  version                   Int                        @default(1)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  recipient                 NotificationRecipient      @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  outboxMessage             OutboxMessage              @relation(fields: [outboxMessageId], references: [id], onDelete: Restrict)

  @@unique([recipientId, kind, preferenceVersion, eventVersion], map: "NotificationDelivery_recipient_kind_preference_event_key")
  @@index([status, scheduledFor])
  @@index([recipientId, createdAt])
}

enum SecurityEventSeverity {
  info
  warning
  critical
}

enum SecurityEventOutcome {
  succeeded
  denied
  failed
}

model AuditLog {
  id                   String          @id
  actorId              String?
  actorRole            String?
  labId                String?
  requestId            String?
  commandReceiptId     String?
  commandType          String?
  commandAggregateType String?
  commandAggregateId   String?
  entityType           String
  entityId             String
  action               String
  previousValue        Json?
  newValue             Json?
  timestamp            DateTime
  actor                User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  lab                  Lab?            @relation(fields: [labId], references: [id], onDelete: Restrict)
  commandReceipt       CommandReceipt? @relation(fields: [commandReceiptId], references: [id], onDelete: Restrict)

  @@index([timestamp])
  @@index([labId, timestamp])
  @@index([entityType, entityId, timestamp])
  @@index([requestId])
}

model SecurityEvent {
  id            String                @id
  eventType     String
  severity      SecurityEventSeverity @default(info)
  outcome       SecurityEventOutcome
  actorId       String?
  actorRole     String                @default("system")
  scopeLabId    String?
  correlationId String?
  dedupeKey     String?               @unique
  subjectType   String?
  subjectId     String?
  source        String
  summary       String
  occurredAt    DateTime              @default(now())
  actor         User?                 @relation("SecurityEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  scopeLab      Lab?                  @relation(fields: [scopeLabId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@index([severity, occurredAt])
  @@index([actorId, occurredAt])
  @@index([scopeLabId, occurredAt])
  @@index([correlationId])
}

model WorkflowDraft {
  id              String                   @id
  workflowType    String
  actorId         String
  labId           String?
  status          WorkflowDraftStatus      @default(draft)
  version         Int                      @default(1)
  payload         Json
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  expiresAt       DateTime?
  submittedAt     DateTime?
  committedAt     DateTime?
  cancelledAt     DateTime?
  actor           User                     @relation("WorkflowDraftActor", fields: [actorId], references: [id], onDelete: Restrict)
  lab             Lab?                     @relation(fields: [labId], references: [id], onDelete: Restrict)
  reviewSnapshots WorkflowReviewSnapshot[]
  commandReceipts CommandReceipt[]

  @@index([actorId, status])
  @@index([labId, status])
  @@index([workflowType, status])
  @@index([expiresAt, status])
}

model WorkflowReviewSnapshot {
  id           String        @id
  draftId      String
  draftVersion Int
  payload      Json
  payloadHash  String
  createdById  String
  createdAt    DateTime      @default(now())
  draft        WorkflowDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("WorkflowSnapshotActor", fields: [createdById], references: [id], onDelete: Restrict)
  cageClosure  CageClosure?

  @@unique([draftId, draftVersion])
  @@index([createdById, createdAt])
}

model CommandReceipt {
  id                             String                               @id
  actorId                        String
  actorAuthzVersion              Int                                  @default(0)
  databasePrincipal              String                               @default(dbgenerated("SESSION_USER"))
  labId                          String?
  workflowDraftId                String?
  commandType                    String
  idempotencyKey                 String
  requestHash                    String
  requestId                      String
  transactionId                  BigInt                               @default(dbgenerated("txid_current()"))
  status                         CommandReceiptStatus                 @default(processing)
  aggregateType                  String?
  aggregateId                    String?
  expectedVersion                Int?
  resultingVersion               Int?
  result                         Json?
  errorCode                      String?
  errorMessage                   String?
  startedAt                      DateTime                             @default(now())
  completedAt                    DateTime?
  actor                          User                                 @relation("CommandReceiptActor", fields: [actorId], references: [id], onDelete: Restrict)
  lab                            Lab?                                 @relation(fields: [labId], references: [id], onDelete: Restrict)
  workflowDraft                  WorkflowDraft?                       @relation(fields: [workflowDraftId], references: [id], onDelete: SetNull)
  auditLogs                      AuditLog[]
  protocolAllocationHistory      ProtocolCountAllocationHistory[]
  protocolAllocationReceipts     ProtocolCountAllocation[]            @relation("ProtocolCountAllocationCreationReceipt")
  complianceEvidence             ComplianceEvidenceSnapshot[]
  protocolGovernanceEvent        ProtocolAuthorizationLifecycleEvent?
  competencyGovernanceEvent      CompetencyLifecycleEvent?
  protocolVersionCreated         ProtocolAuthorizationVersion?        @relation("ProtocolVersionCreationReceipt")
  competencyVersionIssued        CompetencyEvidenceVersion?           @relation("CompetencyVersionReceipt")
  welfareObservations            WelfareObservation[]
  welfareAdministrations         WelfareAdministrationAttempt[]
  welfareCaseEvents              WelfareCaseLifecycleEvent[]
  welfareCasesOpened             WelfareCase[]                        @relation("WelfareCaseOpenReceipt")
  welfareCasesLastMutation       WelfareCase[]                        @relation("WelfareCaseLastReceipt")
  welfareOrdersProposed          WelfareTreatmentOrder[]              @relation("WelfareOrderProposalReceipt")
  welfareOrdersLastMutation      WelfareTreatmentOrder[]              @relation("WelfareOrderLastReceipt")
  welfareEscalationsOpened       WelfareEscalation[]                  @relation("WelfareEscalationOpenReceipt")
  welfareEscalationsLastMutation WelfareEscalation[]                  @relation("WelfareEscalationLastReceipt")

  @@unique([actorId, commandType, idempotencyKey])
  @@index([requestId])
  @@index([labId, startedAt])
  @@index([aggregateType, aggregateId])
}

model OutboxMessage {
  id                          String                  @id
  topic                       String
  dedupeKey                   String?                 @unique
  aggregateType               String
  aggregateId                 String
  actorId                     String?
  actorAuthzVersion           Int?
  labId                       String?
  requiredCapability          String?
  payload                     Json
  status                      OutboxMessageStatus     @default(pending)
  attemptCount                Int                     @default(0)
  maxAttempts                 Int                     @default(8)
  availableAt                 DateTime                @default(now())
  leaseOwner                  String?
  leaseToken                  String?                 @unique
  workerType                  String?
  leasedAt                    DateTime?
  leaseExpiresAt              DateTime?
  authorizedAt                DateTime?
  authorizedCapability        String?
  authorizedActorAuthzVersion Int?
  deliveredAt                 DateTime?
  deadLetteredAt              DateTime?
  lastError                   String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  actor                       User?                   @relation("OutboxActor", fields: [actorId], references: [id], onDelete: SetNull)
  lab                         Lab?                    @relation(fields: [labId], references: [id], onDelete: Restrict)
  attempts                    OutboxDeliveryAttempt[]
  notificationDelivery        NotificationDelivery?

  @@index([status, availableAt])
  @@index([topic, status])
  @@index([labId, status])
  @@index([leaseExpiresAt])
}

model OutboxDeliveryAttempt {
  id                   String              @id
  messageId            String
  attemptNumber        Int
  workerId             String
  workerType           String
  leaseToken           String              @unique
  status               OutboxAttemptStatus @default(processing)
  authorizedAt         DateTime
  authorizedCapability String
  startedAt            DateTime            @default(now())
  completedAt          DateTime?
  errorMessage         String?
  message              OutboxMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, attemptNumber])
  @@index([workerId, startedAt])
}

model FacilityIdentitySequence {
  entityType   FacilityIdentifierType         @id
  nextValue    Int
  minimumValue Int
  maximumValue Int
  width        Int                            @default(4)
  updatedAt    DateTime                       @updatedAt
  assignments  FacilityIdentifierAssignment[]
}

model FacilityIdentifierAssignment {
  id            String                   @id
  entityType    FacilityIdentifierType
  sequenceValue Int
  displayId     String
  entityId      String
  issuedAt      DateTime                 @default(now())
  sequence      FacilityIdentitySequence @relation(fields: [entityType], references: [entityType], onDelete: Restrict)

  @@unique([entityType, sequenceValue])
  @@unique([entityType, displayId])
  @@unique([entityType, entityId])
  @@index([entityId])
}

model LegacyIdentifierAlias {
  id                 String                 @id
  entityType         FacilityIdentifierType
  entityId           String
  alias              String
  canonicalDisplayId String
  source             String
  createdAt          DateTime               @default(now())

  @@unique([entityType, alias])
  @@index([entityType, entityId])
}

model MigrationRun {
  id            String               @id
  runKey        String               @unique
  migrationType String
  status        MigrationRunStatus   @default(planned)
  initiatedById String?
  startedAt     DateTime?
  completedAt   DateTime?
  summary       Json?
  errorMessage  String?
  createdAt     DateTime             @default(now())
  initiatedBy   User?                @relation("MigrationRunActor", fields: [initiatedById], references: [id], onDelete: SetNull)
  exceptions    OwnershipException[]

  @@index([migrationType, status])
}

model OwnershipException {
  id             String                   @id
  migrationRunId String?
  entityType     String
  entityId       String
  fieldName      String
  currentValue   Json?
  candidates     Json?
  reason         String
  status         OwnershipExceptionStatus @default(open)
  resolution     Json?
  resolvedById   String?
  createdAt      DateTime                 @default(now())
  resolvedAt     DateTime?
  migrationRun   MigrationRun?            @relation(fields: [migrationRunId], references: [id], onDelete: Restrict)
  resolvedBy     User?                    @relation("OwnershipExceptionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([migrationRunId, status])
  @@index([entityType, entityId, status])
}
