  competencyEvidence          CompetencyEvidence           @relation(fields: [competencyEvidenceId, labId], references: [id, labId], onDelete: Restrict, onUpdate: NoAction, map: "ComplianceEvidenceSnapshot_competency_fkey")
  competencyVersion           CompetencyEvidenceVersion    @relation(fields: [competencyVersionId, competencyEvidenceId], references: [id, evidenceId], onDelete: Restrict, onUpdate: NoAction, map: "ComplianceEvidenceSnapshot_competency_version_fkey")
  identityLink                ExternalIdentityLink         @relation(fields: [identityLinkId], references: [id], onDelete: Restrict, map: "ComplianceEvidenceSnapshot_identity_fkey")
  dutyAssignment              FacilityDutyAssignment?      @relation(fields: [dutyAssignmentId, dutyAssignmentVersion], references: [id, version], onDelete: Restrict, onUpdate: NoAction, map: "ComplianceEvidenceSnapshot_duty_fkey")
  ledger                      ProtocolCountLedger          @relation(fields: [ledgerId], references: [id], onDelete: Restrict, map: "ComplianceEvidenceSnapshot_ledger_fkey")
  actor                       User                         @relation("ComplianceEvidenceActor", fields: [actorId], references: [id], onDelete: Restrict, map: "ComplianceEvidenceSnapshot_actor_fkey")
  lab                         Lab                          @relation(fields: [labId], references: [id], onDelete: Restrict, map: "ComplianceEvidenceSnapshot_lab_fkey")
  commandReceipt              CommandReceipt               @relation(fields: [commandReceiptId], references: [id], onDelete: Restrict, map: "ComplianceEvidenceSnapshot_receipt_fkey")
  experiments                 Experiment[]
  breedingSetups              BreedingSetup[]
  intakeBatches               AnimalIntakeBatch[]
  sourceTransferRequests      LabTransferRequest[]         @relation("LabTransferSourceEvidence")
  destinationTransferRequests LabTransferRequest[]         @relation("LabTransferDestinationEvidence")
  procedurePlans              ProcedurePlan[]
  procedureOccurrences        ProcedureOccurrence[]
  experimentAssignments       ExperimentAssignment[]
  litters                     Litter[]

  @@unique([commandReceiptId, evidenceKey], map: "ComplianceEvidenceSnapshot_receipt_evidence_key")
  @@index([protocolAuthorizationId, protocolVersionId], map: "ComplianceEvidenceSnapshot_protocol_idx")
  @@index([actorId, evaluatedAt], map: "ComplianceEvidenceSnapshot_actor_time_idx")
  @@index([aggregateType, aggregateId], map: "ComplianceEvidenceSnapshot_aggregate_idx")
}

model LabMembership {
  id                   String                   @id
  labId                String
  userId               String
  role                 LabMembershipRole
  active               Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  lab                  Lab                      @relation(fields: [labId], references: [id], onDelete: Cascade)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cageResponsibilities CageUserAssignment[]
  directoryContacts    StrainDirectoryListing[] @relation("StrainDirectoryContact")

  @@unique([labId, userId])
  @@index([userId])
}

model Facility {
  id                String   @id
  name              String
  cageBarcodePrefix String   @unique @default("CM")
  maxCageOccupancy  Int      @default(6)
  notes             String?
  rooms             Room[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Room {
  id         String   @id
  facilityId String
  roomNumber String
  notes      String?
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  racks      Rack[]
  cages      Cage[]

