  protocolVersion             ProtocolAuthorizationVersion @relation(fields: [protocolVersionId, protocolAuthorizationId], references: [id, authorizationId], onDelete: Restrict, onUpdate: NoAction, map: "ComplianceEvidenceSnapshot_protocol_version_fkey")
