model Animal {
  id                    String                    @id
  facilityAnimalId      String                    @unique
  animalId              String                    @unique
  labId                 String                    @unique
  owningLabId           String
  intakeBatchId         String?
  sourceAnimalId        String?
  sex                   Sex
  dob                   DateTime
  strainId              String
  currentCageId         String?
  status                AnimalStatus
  originType            String
  sireId                String?
  damId                 String?
  breedingGeneration    String?
  healthStatus          String?
  projectSummary        String?
  experimentalStatus    String?
  outcomeStatus         OutcomeStatus             @default(alive)
  deathDate             DateTime?
  deathReason           String?
  notes                 String?
  version               Int                       @default(1)
  owningLab             Lab                       @relation(fields: [owningLabId], references: [id], onDelete: Restrict)
  intakeBatch           AnimalIntakeBatch?        @relation(fields: [intakeBatchId], references: [id], onDelete: SetNull)
  strain                Strain                    @relation(fields: [strainId], references: [id], onDelete: Restrict)
