generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  it_head
  facility_admin
  cmu_staff
  lab_user
  // Transitional values retained until populated-data role migration is verified.
  admin
  colony_manager
  animal_staff
  researcher
  read_only
}

enum LabMembershipRole {
  owner
  manager
  staff
  viewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum PrivilegedRoleChangeStatus {
  pending
  approved
  rejected
  expired
}

enum InvoiceStatus {
  draft
  finalized
  void
}

enum InvoiceAdjustmentType {
  debit
  credit
}

enum Sex {
  male
  female
  unknown
}

enum CageStatus {
  active
  breeding
  quarantine
  experiment
  retired
  closed
}

enum AnimalStatus {
  planned
  born
  nursing
  weaned
  colony_holding
  breeding
  reserved
  in_experiment
  experiment_completed
  euthanized
  dead
  transferred_out
  archived
}

enum OutcomeStatus {
  alive
  euthanized
  dead
  transferred
  missing
}

enum ExperimentStatus {
  planned
  active
  completed
  cancelled
}

enum AssignmentStatus {
  planned
  reserved
  active
  completed
  cancelled
}

enum HealthNoteType {
  routine_welfare
  adverse_effect
  veterinary_concern
  breeding_concern
  underweight
  overweight
  grooming_issue
  aggression
  pregnancy_suspicion
  delivery_observed
  post_procedure_monitoring
}

enum AlertSeverity {
  info
  warning
  critical
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

enum NotificationAudienceType {
  user
  lab_members
  facility_role
}

enum NotificationRecipientStatus {
  active
  revoked
}

enum NotificationEmailMode {
  off
  daily_digest
  weekly_digest
}

enum NotificationDeliveryKind {
  immediate
  digest
}

enum NotificationDeliveryStatus {
  queued
  delivered
  failed
  cancelled
}

enum GenotypeCallStatus {
  pending
  provisional
  confirmed
  conflict
}

enum SampleStatus {
  collected
  stored
  allocated
  consumed
  discarded
}

enum CryostorageStatus {
  stored
  reserved
  recovered
  depleted
  discarded
}

enum CryostorageRequestType {
  store
  recover
  discard
}

enum CryostorageRequestStatus {
  submitted
  completed
  rejected
  cancelled
}

enum CryostorageRequestEventType {
  submitted
  completed
  rejected
  cancelled
}

enum CryostorageOperationType {
  store
  recover
  discard
}

enum StrainDirectoryListingStatus {
  draft
  shared
  paused
}

enum StrainDirectoryRequestType {
  contact
  material
}

enum StrainDirectoryRequestStatus {
  submitted
  accepted
  declined
  cancelled
}

enum StrainDirectoryRequestEventType {
  submitted
  accepted
  declined
  cancelled
}

enum BreedingStatus {
  planned
  active
  paused
  retired
  failed
}

enum AnimalIntakeDisposition {
  holding
  quarantine
}

enum QuarantineCaseStatus {
  admitted
  under_observation
  exception_open
  release_requested
  released
  cancelled
}

enum QuarantineObservationResult {
  clear
  monitor
  exception
  exception_resolved
}

enum RuleCategory {
  breeding
  welfare
  compliance
  genotype
  experiment
  capacity
}

enum BreedingAdultRole {
  sire
  dam
  support
}

enum WorkflowDraftStatus {
  draft
  review
  submitted
  committed
  cancelled
  expired
}

enum CommandReceiptStatus {
  processing
  succeeded
  failed
}

enum OutboxMessageStatus {
  pending
  leased
  retry
  delivered
  dead_letter
  cancelled
}

enum OutboxAttemptStatus {
  processing
  delivered
  failed
}

enum FacilityIdentifierType {
  animal
  cage
}

enum MigrationRunStatus {
  planned
  running
  succeeded
  failed
  rolled_back
}

enum OwnershipExceptionStatus {
  open
  resolved
  rejected
}

enum LabTransferSubjectType {
  cage
  animals
}

enum LabTransferRequestStatus {
  requested
  destination_accepted
  destination_rejected
  cancelled
  finalized
}

enum LabTransferEventType {
  requested
  packet_revised
  destination_accepted
  destination_rejected
  cancelled
  override_applied
  finalized
}

enum SopScope {
  facility
  lab
}

enum SopApprovalDecision {
  approved
  rejected
}

enum ProcedurePlanStatus {
  planned
  completed
  cancelled
}

enum ProcedureOccurrenceStatus {
  completed
  not_performed
  aborted
}

model User {
  id                           String                        @id
  name                         String
  email                        String                        @unique
  passwordHash                 String
  role                         UserRole
  active                       Boolean                       @default(true)
  authzVersion                 Int                           @default(1)
  labMemberships               LabMembership[]
  projectsOwned                Project[]                     @relation("ProjectOwner")
  experimentsOwned             Experiment[]                  @relation("ExperimentOwner")
  healthNotesCreated           HealthNote[]                  @relation("HealthNoteCreator")
  auditLogs                    AuditLog[]                    @relation("AuditActor")
  securityEvents               SecurityEvent[]               @relation("SecurityEventActor")
  cageMoves                    CageMovement[]                @relation("CageMoveActor")
  animalMoves                  AnimalMovement[]              @relation("AnimalMoveActor")
  cageLabTransfers             CageLabTransfer[]             @relation("CageLabTransferActor")
  animalLabTransfers           AnimalLabTransfer[]           @relation("AnimalLabTransferActor")
  finalizedInvoices            Invoice[]                     @relation("InvoiceFinalizer")
  voidedInvoices               Invoice[]                     @relation("InvoiceVoider")
  invoiceAdjustmentsCreated    InvoiceAdjustment[]           @relation("InvoiceAdjustmentCreator")
  statusEvents                 AnimalStatusEvent[]           @relation("StatusEventActor")
  genotypesPerformed           GenotypingRecord[]            @relation("GenotypeOperator")
  genotypesVerified            GenotypingRecord[]            @relation("GenotypeVerifier")
  sampleRecordsCreated         SampleRecord[]                @relation("SampleRecordCreator")
  cryostorageRecordsCreated    CryostorageRecord[]           @relation("CryostorageRecordCreator")
  cryostorageRequestsCreated   CryostorageRequest[]          @relation("CryostorageRequestCreator")
  cryostorageRequestsDecided   CryostorageRequest[]          @relation("CryostorageRequestDecisionActor")
  cryostorageRequestEvents     CryostorageRequestEvent[]     @relation("CryostorageRequestEventActor")
  cryostorageOperations        CryostorageOperation[]        @relation("CryostorageOperationActor")
  animalIntakeBatchesCreated   AnimalIntakeBatch[]           @relation("AnimalIntakeBatchCreator")
  invitationsSent              UserInvitation[]              @relation("InvitationSender")
  privilegedChangesTarget      PrivilegedRoleChangeRequest[] @relation("PrivilegedChangeTarget")
  privilegedChangesRequested   PrivilegedRoleChangeRequest[] @relation("PrivilegedChangeRequester")
  privilegedChangesApproved    PrivilegedRoleChangeRequest[] @relation("PrivilegedChangeApprover")
  workflowDrafts               WorkflowDraft[]               @relation("WorkflowDraftActor")
  workflowReviewSnapshots      WorkflowReviewSnapshot[]      @relation("WorkflowSnapshotActor")
  commandReceipts              CommandReceipt[]              @relation("CommandReceiptActor")
  outboxMessages               OutboxMessage[]               @relation("OutboxActor")
  migrationRuns                MigrationRun[]                @relation("MigrationRunActor")
  ownershipExceptionsResolved  OwnershipException[]          @relation("OwnershipExceptionResolver")
  quarantineCasesAdmitted      QuarantineCase[]              @relation("QuarantineAdmissionActor")
  quarantineReleasesRequested  QuarantineCase[]              @relation("QuarantineReleaseRequester")
  quarantineCasesReleased      QuarantineCase[]              @relation("QuarantineReleaseActor")
  quarantineObservations       QuarantineObservation[]       @relation("QuarantineObservationActor")
  cageClosures                 CageClosure[]                 @relation("CageClosureActor")
  labTransferRequestsCreated   LabTransferRequest[]          @relation("LabTransferRequester")
  labTransferDecisions         LabTransferRequest[]          @relation("LabTransferDestinationDecision")
  labTransferFinalizations     LabTransferRequest[]          @relation("LabTransferFinalizer")
  labTransferOverrides         LabTransferRequest[]          @relation("LabTransferOverrideApprover")
  labTransferPacketsCreated    LabTransferPacket[]           @relation("LabTransferPacketCreator")
  labTransferEvents            LabTransferEvent[]            @relation("LabTransferEventActor")
  sopDocumentsCreated          SopDocument[]                 @relation("SopDocumentCreator")
  sopVersionsCreated           SopVersion[]                  @relation("SopVersionCreator")
  sopVersionApprovals          SopVersionApproval[]          @relation("SopVersionApprovalActor")
  sopAssignmentsAssigned       SopAssignment[]               @relation("SopAssignmentActor")
  sopAssignmentsRevoked        SopAssignment[]               @relation("SopAssignmentRevoker")
  sopAcknowledgements          SopAcknowledgement[]          @relation("SopAcknowledgementUser")
  procedurePlansCreated        ProcedurePlan[]               @relation("ProcedurePlanCreator")
  procedureOccurrencesExecuted ProcedureOccurrence[]         @relation("ProcedureOccurrenceExecutor")
  cageResponsibilities         CageUserAssignment[]          @relation("CageResponsibleUser")
  cageResponsibilityChanges    CageUserAssignment[]          @relation("CageResponsibilityActor")
  cageResponsibilitiesEnded    CageUserAssignment[]          @relation("CageResponsibilityEndActor")
  notificationAudienceTargets  NotificationAudience[]        @relation("NotificationAudienceUser")
  notificationRecipients       NotificationRecipient[]       @relation("NotificationRecipientUser")
  notificationPreferences      NotificationPreference[]
  strainDirectoryRequests      StrainDirectoryRequest[]      @relation("StrainDirectoryRequester")
  strainDirectoryDecisions     StrainDirectoryRequest[]      @relation("StrainDirectoryDecisionActor")
  strainDirectoryEvents        StrainDirectoryRequestEvent[] @relation("StrainDirectoryRequestEventActor")
}

model Lab {
  id                      String                        @id
  name                    String
  code                    String                        @unique
  billingContact          String?
  notes                   String?
  active                  Boolean                       @default(true)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  memberships             LabMembership[]
  cages                   Cage[]
  animals                 Animal[]
  chargePeriods           CageChargePeriod[]
  invoices                Invoice[]
  invoiceAdjustments      InvoiceAdjustment[]
  cageTransfersFrom       CageLabTransfer[]             @relation("CageTransferFromLab")
  cageTransfersTo         CageLabTransfer[]             @relation("CageTransferToLab")
  animalTransfersFrom     AnimalLabTransfer[]           @relation("AnimalTransferFromLab")
  animalTransfersTo       AnimalLabTransfer[]           @relation("AnimalTransferToLab")
  animalIntakeBatches     AnimalIntakeBatch[]
  invitations             UserInvitation[]
  projects                Project[]
  experiments             Experiment[]
  breedingSetups          BreedingSetup[]
  sampleRecords           SampleRecord[]
  cryostorageRecords      CryostorageRecord[]
  cryostorageRequests     CryostorageRequest[]
  cryostorageEvents       CryostorageRequestEvent[]
  cryostorageOperations   CryostorageOperation[]
  healthNotes             HealthNote[]
  genotypingRecords       GenotypingRecord[]
  attachments             Attachment[]
  alerts                  Alert[]
  workflowDrafts          WorkflowDraft[]
  commandReceipts         CommandReceipt[]
  outboxMessages          OutboxMessage[]
  quarantineCases         QuarantineCase[]
  quarantineObservations  QuarantineObservation[]
  cageClosures            CageClosure[]
  transferRequestsFrom    LabTransferRequest[]          @relation("LabTransferSourceLab")
  transferRequestsTo      LabTransferRequest[]          @relation("LabTransferDestinationLab")
  transferEvents          LabTransferEvent[]
  sopDocuments            SopDocument[]
  sopAssignments          SopAssignment[]
  sopAcknowledgements     SopAcknowledgement[]
  procedurePlans          ProcedurePlan[]
  procedureOccurrences    ProcedureOccurrence[]
  notificationEvents      NotificationEvent[]
  notificationAudiences   NotificationAudience[]
  notificationRecipients  NotificationRecipient[]
  auditLogs               AuditLog[]
  scopedSecurityEvents    SecurityEvent[]
  strainDirectoryListings StrainDirectoryListing[]
  strainDirectoryRequests StrainDirectoryRequest[]
  strainDirectoryEvents   StrainDirectoryRequestEvent[]
}

model SopDocument {
  id                   String                @id
  scope                SopScope
  labId                String?
  code                 String
  title                String
  category             String
  active               Boolean               @default(true)
  version              Int                   @default(1)
  currentVersionId     String?               @unique
  createdById          String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  lab                  Lab?                  @relation(fields: [labId], references: [id], onDelete: Restrict)
  createdBy            User                  @relation("SopDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentVersion       SopVersion?           @relation("SopCurrentVersion", fields: [currentVersionId, id], references: [id, sopId], onDelete: Restrict, onUpdate: NoAction)
  versions             SopVersion[]          @relation("SopDocumentVersions")
  assignments          SopAssignment[]
  procedurePlans       ProcedurePlan[]       @relation("ProcedurePlanSop")
  procedureOccurrences ProcedureOccurrence[] @relation("ProcedureOccurrenceSop")
  statusEvents         AnimalStatusEvent[]   @relation("AnimalStatusEventSop")

  @@unique([currentVersionId, id])
  @@index([labId, active])
  @@index([createdById, createdAt])
}

model SopVersion {
  id                   String                @id
  sopId                String
  versionNumber        Int
  title                String
  category             String
  contentMarkdown      String
  contentHash          String
  changeSummary        String
  createdById          String
  createdAt            DateTime              @default(now())
  sop                  SopDocument           @relation("SopDocumentVersions", fields: [sopId], references: [id], onDelete: Restrict)
  currentForDocument   SopDocument?          @relation("SopCurrentVersion")
  createdBy            User                  @relation("SopVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approval             SopVersionApproval?
  assignments          SopAssignment[]
  acknowledgements     SopAcknowledgement[]
  procedurePlans       ProcedurePlan[]       @relation("ProcedurePlanSopVersion")
  procedureOccurrences ProcedureOccurrence[] @relation("ProcedureOccurrenceSopVersion")
  statusEvents         AnimalStatusEvent[]   @relation("AnimalStatusEventSopVersion")

  @@unique([sopId, versionNumber])
  @@unique([id, sopId])
  @@index([createdById, createdAt])
}

model SopVersionApproval {
  id           String              @id
  sopId        String
  sopVersionId String              @unique
  decision     SopApprovalDecision
  decidedById  String
  decidedAt    DateTime            @default(now())
  note         String?
  sopVersion   SopVersion          @relation(fields: [sopVersionId, sopId], references: [id, sopId], onDelete: Restrict, onUpdate: NoAction)
  decidedBy    User                @relation("SopVersionApprovalActor", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([sopVersionId, sopId])
  @@index([sopId, decision])
  @@index([decidedById, decidedAt])
}

model SopAssignment {
  id                   String                @id
  sopId                String
  sopVersionId         String
  labId                String
  assignedById         String
  assignedAt           DateTime              @default(now())
  dueAt                DateTime?
  reason               String
  revokedById          String?
  revokedAt            DateTime?
  revocationReason     String?
  version              Int                   @default(1)
  sop                  SopDocument           @relation(fields: [sopId], references: [id], onDelete: Restrict)
  sopVersion           SopVersion            @relation(fields: [sopVersionId, sopId], references: [id, sopId], onDelete: Restrict, onUpdate: NoAction)
  lab                  Lab                   @relation(fields: [labId], references: [id], onDelete: Restrict)
  assignedBy           User                  @relation("SopAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedBy            User?                 @relation("SopAssignmentRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  acknowledgements     SopAcknowledgement[]
  procedurePlans       ProcedurePlan[]       @relation("ProcedurePlanSopAssignment")
  procedureOccurrences ProcedureOccurrence[] @relation("ProcedureOccurrenceSopAssignment")
  statusEvents         AnimalStatusEvent[]   @relation("AnimalStatusEventSopAssignment")

  @@unique([id, sopId, sopVersionId, labId])
  @@index([sopId, labId])
  @@index([sopVersionId])
  @@index([labId, assignedAt])
  @@index([assignedById, assignedAt])
  @@index([revokedById, revokedAt])
}

model SopAcknowledgement {
  id             String        @id
  assignmentId   String
  sopId          String
  sopVersionId   String
  labId          String
  userId         String
  contentHash    String
  acknowledgedAt DateTime      @default(now())
  attestation    String
  assignment     SopAssignment @relation(fields: [assignmentId, sopId, sopVersionId, labId], references: [id, sopId, sopVersionId, labId], onDelete: Restrict, onUpdate: NoAction)
  sopVersion     SopVersion    @relation(fields: [sopVersionId, sopId], references: [id, sopId], onDelete: Restrict, onUpdate: NoAction)
  lab            Lab           @relation(fields: [labId], references: [id], onDelete: Restrict)
  user           User          @relation("SopAcknowledgementUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, userId])
  @@index([sopId, sopVersionId])
  @@index([labId, acknowledgedAt])
  @@index([userId, acknowledgedAt])
}

model UserInvitation {
  id             String             @id
  email          String
  name           String?
  tokenHash      String             @unique
  status         InvitationStatus   @default(pending)
  targetRole     UserRole
  labId          String?
  membershipRole LabMembershipRole?
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime           @default(now())
  invitedBy      User               @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  lab            Lab?               @relation(fields: [labId], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@index([labId, status])
  @@index([expiresAt, status])
}

model PrivilegedRoleChangeRequest {
  id                      String                     @id
  targetUserId            String
  requestedRole           UserRole
  status                  PrivilegedRoleChangeStatus @default(pending)
  reason                  String
  requestedById           String
  requestedByAuthzVersion Int
  requestedActive         Boolean?
  approvedById            String?
  expiresAt               DateTime
  approvedAt              DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime                   @default(now())
  targetUser              User                       @relation("PrivilegedChangeTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  requestedBy             User                       @relation("PrivilegedChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy              User?                      @relation("PrivilegedChangeApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([targetUserId, status])
  @@index([requestedById, status])
  @@index([expiresAt, status])
}

model LabMembership {
  id                   String                   @id
  labId                String
  userId               String
  role                 LabMembershipRole
  active               Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  lab                  Lab                      @relation(fields: [labId], references: [id], onDelete: Cascade)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cageResponsibilities CageUserAssignment[]
  directoryContacts    StrainDirectoryListing[] @relation("StrainDirectoryContact")

  @@unique([labId, userId])
  @@index([userId])
}

model Facility {
  id                String   @id
  name              String
  cageBarcodePrefix String   @unique @default("CM")
  maxCageOccupancy  Int      @default(6)
  notes             String?
  rooms             Room[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Room {
  id         String   @id
  facilityId String
  roomNumber String
  notes      String?
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  racks      Rack[]
  cages      Cage[]

  @@unique([facilityId, roomNumber])
}

model Rack {
  id         String  @id
  roomId     String
  rackNumber String
  notes      String?
  room       Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cages      Cage[]

  @@unique([roomId, rackNumber])
}

model Cage {
  id                          String               @id
  facilityCageId              String               @unique
  labId                       String
  roomId                      String
  rackId                      String
  cageNumber                  String
  barcode                     String               @unique
  capacityOverride            Int?
  status                      CageStatus
  notes                       String?
  active                      Boolean              @default(true)
  welfareFlags                Json?
  lastUpdatedAt               DateTime             @default(now())
  version                     Int                  @default(1)
  lab                         Lab                  @relation(fields: [labId], references: [id], onDelete: Restrict)
  room                        Room                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  rack                        Rack                 @relation(fields: [rackId], references: [id], onDelete: Restrict)
  animals                     Animal[]
  healthNotes                 HealthNote[]
  cageMovements               CageMovement[]
  chargePeriods               CageChargePeriod[]
  labTransfers                CageLabTransfer[]
  invoiceLines                InvoiceLineItem[]
  attachments                 Attachment[]
  quarantineCases             QuarantineCase[]
  closure                     CageClosure?
  sourceTransferRequests      LabTransferRequest[] @relation("LabTransferSourceCage")
  destinationTransferRequests LabTransferRequest[] @relation("LabTransferDestinationCage")
  transferItems               LabTransferItem[]
  userAssignments             CageUserAssignment[]

  @@unique([rackId, cageNumber])
  @@unique([id, labId])
  @@index([labId])
}

model CageUserAssignment {
  id           String        @id
  cageId       String
  labId        String
  userId       String
  assignedById String
  assignedAt   DateTime      @default(now())
  endedAt      DateTime?
  endedById    String?
  endReason    String?
  version      Int           @default(1)
  reason       String
  cage         Cage          @relation(fields: [cageId], references: [id], onDelete: Restrict)
  membership   LabMembership @relation(fields: [labId, userId], references: [labId, userId], onDelete: Restrict, onUpdate: NoAction)
  user         User          @relation("CageResponsibleUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User          @relation("CageResponsibilityActor", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy      User?         @relation("CageResponsibilityEndActor", fields: [endedById], references: [id], onDelete: Restrict)

  @@unique([cageId, userId, assignedAt])
  @@index([labId, userId, endedAt])
  @@index([cageId, endedAt])
  @@index([assignedById, assignedAt])
  @@index([endedById, endedAt])
}

model Strain {
  id                  String                   @id
  name                String                   @unique
  background          String?
  notes               String?
  maintenanceRules    Json?
  animals             Animal[]
  cryostorageRecords  CryostorageRecord[]
  cryostorageRequests CryostorageRequest[]
  directoryListings   StrainDirectoryListing[]
}

model StrainDirectoryListing {
  id            String                       @id
  strainId      String
  labId         String
  contactUserId String
  status        StrainDirectoryListingStatus @default(draft)
  version       Int                          @default(1)
  sharedAt      DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  strain        Strain                       @relation(fields: [strainId], references: [id], onDelete: Restrict)
  lab           Lab                          @relation(fields: [labId], references: [id], onDelete: Restrict)
  contact       LabMembership                @relation("StrainDirectoryContact", fields: [labId, contactUserId], references: [labId, userId], onDelete: Restrict, onUpdate: NoAction)
  requests      StrainDirectoryRequest[]

  @@unique([strainId, labId])
  @@index([status, labId])
  @@index([contactUserId, status])
}

model StrainDirectoryRequest {
  id              String                        @id
  listingId       String
  requesterUserId String
  requesterLabId  String
  requestType     StrainDirectoryRequestType
  purpose         String?
  status          StrainDirectoryRequestStatus  @default(submitted)
  decidedById     String?
  decidedAt       DateTime?
  decisionReason  String?
  version         Int                           @default(1)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  listing         StrainDirectoryListing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  requester       User                          @relation("StrainDirectoryRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  requesterLab    Lab                           @relation(fields: [requesterLabId], references: [id], onDelete: Restrict)
  decidedBy       User?                         @relation("StrainDirectoryDecisionActor", fields: [decidedById], references: [id], onDelete: Restrict)
  events          StrainDirectoryRequestEvent[]

  @@index([listingId, status, createdAt])
  @@index([requesterUserId, status, createdAt])
  @@index([requesterLabId, status, createdAt])
}

model StrainDirectoryRequestEvent {
  id         String                          @id
  requestId  String
  eventType  StrainDirectoryRequestEventType
  actorId    String
  actorRole  UserRole
  actorLabId String?
  reason     String?
  metadata   Json?
  createdAt  DateTime                        @default(now())
  request    StrainDirectoryRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor      User                            @relation("StrainDirectoryRequestEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorLab   Lab?                            @relation(fields: [actorLabId], references: [id], onDelete: Restrict)

  @@unique([requestId, eventType])
  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorLabId, createdAt])
}

model Allele {
  id                 String         @id
  name               String         @unique
  gene               String
  type               String
  notes              String?
  harmfulHomozygous  Boolean        @default(false)
